rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboard — SOLO LECTURA para los clientes (2026-07-28).
    //
    // Antes el propio jugador escribía su entrada y estas reglas validaban el RANGO de cada campo.
    // Eso paraba la basura, pero no la TRAMPA: `level = 2000, xp = 100000000` está dentro de rango
    // y era una escritura perfectamente válida desde un APK modificado. Validar legitimidad
    // (monotonía, ritmo humano, coherencia entre nivel y XP) es imposible en una regla, porque hace
    // falta comparar contra el estado anterior y contra el reloj del servidor.
    //
    // Ahora escribe únicamente `functions/index.js` (Admin SDK, que ignora estas reglas) a través
    // de las funciones `submitLeaderboardEntry` y `submitInfiniteScore`.
    match /leaderboard/{uid} {
      function isSelf() {
        return request.auth != null && request.auth.uid == uid;
      }

      // get = una entrada concreta (perfil del jugador). list = ranking: se acota el tamaño de la
      // consulta para que un cliente no pueda barrer la colección entera (coste/abuso). Todas las
      // consultas de la app piden límite ≤ 50.
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;

      // Ningún cliente escribe. Ni el dueño de la entrada.
      allow create, update: if false;

      // El BORRADO sí sigue siendo del cliente: lo necesitan el borrado de cuenta (que debe poder
      // limpiar sus propios datos aunque las funciones estén caídas), el restablecimiento de
      // progreso y la migración a una cuenta canónica.
      allow delete: if isSelf();
    }

    // Estado del jugador + comandos admin.
    // Cada documento queda ligado al Firebase Auth UID que lo crea mediante owner_uid.
    // El admin escribe set_coins/set_level/set_crystal_1..4 desde Firebase Console (Admin SDK bypassa reglas).
    match /player_stats/{deviceId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return isSignedIn() && resource.data.owner_uid == request.auth.uid;
      }

      function keepsOwner() {
        return request.resource.data.owner_uid == resource.data.owner_uid;
      }

      // Tipos y rangos de los campos de ESTADO que la app escribe (condicional a presencia:
      // pushPlayerStats usa merge y puede no traerlos todos).
      function validStateValues() {
        let d = request.resource.data;
        return (!d.keys().hasAny(["owner_uid"])
                || (d.owner_uid is string && d.owner_uid.size() <= 128))
          && (!d.keys().hasAny(["player_id"])
                || (d.player_id is string && d.player_id.size() <= 128))
          && (!d.keys().hasAny(["coins"])
                || (d.coins is int && d.coins >= 0 && d.coins <= 100000000))
          && (!d.keys().hasAny(["max_level"])
                || (d.max_level is int && d.max_level >= 0 && d.max_level <= 2000))
          && (!d.keys().hasAny(["display_name"])
                || (d.display_name is string && d.display_name.size() <= 40))
          && (!d.keys().hasAny(["crystals"])
                || d.crystals is map);
      }

      function createsOwnStatsDocument() {
        return isSignedIn()
          && request.resource.data.owner_uid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "owner_uid",
            "player_id",
            "coins",
            "max_level",
            "display_name",
            "updated_at",
            "crystals"
          ])
          && validStateValues();
      }

      function updatesOwnStatsFields() {
        return isOwner()
          && keepsOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "player_id",
            "coins",
            "max_level",
            "display_name",
            "updated_at",
            "owner_uid",
            "crystals"
          ])
          && validStateValues();
      }

      // Migración de documentos creados por versiones anteriores que no guardaban owner_uid.
      // Solo puede añadir el UID actual y actualizar los campos normales de estado.
      function claimsLegacyStatsDocument() {
        return isSignedIn()
          && !resource.data.keys().hasAny(["owner_uid"])
          && request.resource.data.owner_uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "owner_uid",
            "player_id",
            "coins",
            "max_level",
            "display_name",
            "updated_at",
            "crystals"
          ])
          && validStateValues();
      }

      // La app puede añadir campos de comandos que falten, pero únicamente con valores neutros.
      // Así las actualizaciones de esquema no pueden ejecutar ni sobrescribir comandos del admin.
      function initializesCommandSchema() {
        return isOwner()
          && keepsOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "set_coins",
            "set_level",
            "unlock_companions",
            "force_companion",
            "set_crystal_1",
            "set_crystal_2",
            "set_crystal_3",
            "set_crystal_4"
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_coins"])
              || request.resource.data.set_coins == 0)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_level"])
              || request.resource.data.set_level == 0)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["unlock_companions"])
              || request.resource.data.unlock_companions.size() == 0)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["force_companion"])
              || request.resource.data.force_companion == "")
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_crystal_1"])
              || request.resource.data.set_crystal_1 == -1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_crystal_2"])
              || request.resource.data.set_crystal_2 == -1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_crystal_3"])
              || request.resource.data.set_crystal_3 == -1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_crystal_4"])
              || request.resource.data.set_crystal_4 == -1);
      }

      function resetsAdminCommandFields() {
        return isOwner()
          && keepsOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "set_coins",
            "set_level",
            "force_companion",
            "cmd_applied_at",
            "set_crystal_1",
            "set_crystal_2",
            "set_crystal_3",
            "set_crystal_4"
          ])
          && (!request.resource.data.keys().hasAny(["set_coins"]) || request.resource.data.set_coins == 0)
          && (!request.resource.data.keys().hasAny(["set_level"]) || request.resource.data.set_level == 0)
          && (!request.resource.data.keys().hasAny(["force_companion"]) || request.resource.data.force_companion == "")
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_crystal_1"]) || request.resource.data.set_crystal_1 == -1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_crystal_2"]) || request.resource.data.set_crystal_2 == -1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_crystal_3"]) || request.resource.data.set_crystal_3 == -1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["set_crystal_4"]) || request.resource.data.set_crystal_4 == -1)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["cmd_applied_at"]) || request.resource.data.cmd_applied_at is timestamp);
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if createsOwnStatsDocument();
      allow update: if updatesOwnStatsFields()
        || claimsLegacyStatsDocument()
        || initializesCommandSchema()
        || resetsAdminCommandFields();
      // La migración de identidad elimina documentos alias (Android ID / Player ID) únicamente
      // mientras el UID propietario todavía está autenticado.
      allow delete: if isOwner();
    }

    // Respaldo de progreso en la nube ("Continuar con Google" — Facebook se eliminó el 2026-07-31
    // y no vuelve; este comentario lo siguió nombrando hasta el 2026-09-07). El doc se llama con el
    // Firebase Auth UID del jugador; solo ese usuario autenticado puede leer/escribir su propio
    // progreso. Esquema validado: exactamente los campos que escribe CloudSaveRepository.save
    // ("json" string + "updatedAtEpochMs" number) y con tope de tamaño — el límite duro de
    // Firestore es 1 MiB/doc; cortar en 900 KB deja margen y bloquea payloads basura.
    match /cloud_saves/{uid} {
      function isSelf() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validCloudSave() {
        return request.resource.data.keys().hasOnly(["json", "updatedAtEpochMs"])
          && request.resource.data.json is string
          && request.resource.data.json.size() >= 2
          && request.resource.data.json.size() <= 900000
          && request.resource.data.updatedAtEpochMs is int
          && request.resource.data.updatedAtEpochMs > 0;
      }

      allow read: if isSelf();
      allow create, update: if isSelf() && validCloudSave();
      // "Restablecer progreso" borra el respaldo para que no reviva al reconectar.
      allow delete: if isSelf();
    }
  }
}
